# ==============================================================================
# AI Student Performance Analyzer Environment Configuration
# ==============================================================================

# Application Environment (development or production)
FLASK_ENV=development

# Server Network Binding
# 0.0.0.0 allows LAN and Docker container access; 127.0.0.1 restricts to local machine only
HOST=0.0.0.0
PORT=8051

# Production WSGI Concurrency (Gunicorn in Docker)
WORKERS=2
THREADS=4

# AI API Key (Groq) - Required for AI narrative analysis and PDF AI extraction
# Get an API key from https://console.groq.com/
GROQ_API_KEY=

# Secret key used for session signing and cryptographic cookies
SECRET_KEY=dev-secret-key-change-in-production

# Deployment Base Path / URL Prefix
# Leave empty for domain root (e.g., http://localhost:8051/ or https://domain.com/)
# Set if hosted under a subpath (e.g., /student-analysis for https://domain.com:8054/student-analysis/)
APPLICATION_ROOT=

# Public Origin (Optional - used if fully qualified external URLs are needed)
# Example: https://example.com:8054
PUBLIC_ORIGIN=
PREFERRED_URL_SCHEME=http

# Reverse Proxy Forwarded Headers (ProxyFix)
# Set TRUST_PROXY_HEADERS to true when running behind Nginx, Traefik, or Docker reverse proxy
# TRUSTED_PROXIES is the number of trusted proxy levels (default: 1)
TRUST_PROXY_HEADERS=true
TRUSTED_PROXIES=1

# CORS & Allowed Hosts
# In development, '*' allows requests from any host.
# In production, provide a comma-separated list of allowed origins, e.g.:
# CORS_ORIGINS=https://example.com,https://example.com:8054
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# File Upload Limit in Megabytes (applies to CSV, XLSX, XLS, and PDF uploads)
MAX_UPLOAD_SIZE_MB=25

# Swagger / OpenAPI Interactive Documentation UI (/swagger)
ENABLE_DOCS=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
